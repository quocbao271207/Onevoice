# ============================================================
# MediVoice Edge — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
.venv/
.venv-aihub-models/

# Data & Models (large files — do NOT commit)
data/raw/
data/processed/
data/augmented/
data/reports/
# Keep only machine-readable bake-off status and the corrected legacy evidence.
!data/reports/
data/reports/*
!data/reports/model_bakeoff/
data/reports/model_bakeoff/*
!data/reports/model_bakeoff/comparison.json
!data/reports/experiments/
data/reports/experiments/*
!data/reports/experiments/decoding/
data/reports/experiments/decoding/*
!data/reports/experiments/decoding/mt_val_greedy_rescored.json
!data/reports/experiments/scoring/
data/reports/experiments/scoring/*
!data/reports/experiments/scoring/mt_bootstrap_fullscale_smoke.json
data/review/
models/asr/
models/mt/
models/tts/
models/dlc/
*.bin
*.pt
*.pth
*.onnx
*.dlc
*.safetensors

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs & Outputs
logs/
*.log
wandb/
runs/
outputs/
gpu-runs/
test/
.cache/
.backups/

# Jupyter
.ipynb_checkpoints/

# Misc
*.tar.gz
*.zip
